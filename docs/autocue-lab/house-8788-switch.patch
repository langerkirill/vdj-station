+# AutoCue (vdj_cuer, vdj_database_safety, vdj_cue_patch) comes from the canonical
+# checkout when VDJ_AUTOCUE_ROOT is set (sorter/autocue_path.py puts it first on
+# sys.path). Unset = the fork's vendored copy, as before.
+export VDJ_AUTOCUE_ROOT="${VDJ_AUTOCUE_ROOT:-}"
+if [ -n "$VDJ_AUTOCUE_ROOT" ]; then
+  [ -f "$VDJ_AUTOCUE_ROOT/vdj_database_safety.py" ] || { echo "[start_8788] VDJ_AUTOCUE_ROOT=$VDJ_AUTOCUE_ROOT has no vdj_database_safety.py"; exit 1; }
+  export PYTHONPATH="$VDJ_AUTOCUE_ROOT:$FORK_ROOT${PYTHONPATH:+:$PYTHONPATH}"
+else
+  export PYTHONPATH="$FORK_ROOT${PYTHONPATH:+:$PYTHONPATH}"
+fi
 mkdir -p "$MUSIC_SORTER_NOTES_DIR"   # the ONLY directory this fork creates up front
