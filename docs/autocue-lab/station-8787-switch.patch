@@ -2,6 +2,7 @@
 
 from __future__ import annotations
 
+import os
 import sys
 from pathlib import Path
 
@@ -20,7 +21,23 @@ def ensure_autocue_on_path() -> Path:
               autocue_path.py
 
     Also supports older checkouts named vdj-automatic-cuer.
+
+    ``VDJ_AUTOCUE_ROOT`` (the canonical AutoCue checkout) wins over everything
+    else and goes to the front of sys.path, ahead of any vendored copy here.
     """
+    override = os.environ.get("VDJ_AUTOCUE_ROOT", "").strip()
+    if override:
+        root = Path(override).expanduser().resolve()
+        if not (root / "vdj_database_safety.py").is_file():
+            raise RuntimeError(
+                f"VDJ_AUTOCUE_ROOT={override} has no vdj_database_safety.py; "
+                "point it at the canonical AutoCue checkout."
+            )
+        path_str = str(root)
+        if path_str in sys.path:
+            sys.path.remove(path_str)
+        sys.path.insert(0, path_str)
+        return root
