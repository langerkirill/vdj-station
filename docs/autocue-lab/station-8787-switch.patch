diff --git a/ui/tests/conftest.py b/ui/tests/conftest.py
new file mode 100644
index 0000000..0bfcee4
--- /dev/null
+++ b/ui/tests/conftest.py
@@ -0,0 +1,24 @@
+"""Station UI test harness for the canonical AutoCue (VDJ_AUTOCUE_ROOT).
+
+The canonical safety module hard-gates CRLF / VDJ Song-row form; these legacy fixtures are
+LF-only, so the gates are relaxed for the TEST PROCESS only (never set in production).
+"""
+from __future__ import annotations
+
+import os
+import sys
+import tempfile
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+for p in (str(ROOT), str(ROOT / "ui")):
+    if p not in sys.path:
+        sys.path.insert(0, p)
+_AUTOCUE_ROOT = os.environ.get("VDJ_AUTOCUE_ROOT", "").strip()
+if _AUTOCUE_ROOT:
+    sys.path.insert(0, str(Path(_AUTOCUE_ROOT).expanduser().resolve()))
+
+os.environ.setdefault("MUSIC_SORTER_ALLOW_LF_DB", "1")
+os.environ.setdefault("VDJ_ALLOW_RUNNING_WRITES", "1")
+os.environ["MUSIC_SORTER_WRITE_BACKUP_DIR"] = tempfile.mkdtemp(prefix="station-test-backups-")
+os.environ["VDJ_DB_VERIFIED_CACHE"] = os.path.join(tempfile.mkdtemp(prefix="station-test-verified-"), "verified_databases.json")
